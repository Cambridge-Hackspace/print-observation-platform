# POP as a container image (#9): the web app built, then the one binary that
# serves it (#4), on a slim Debian matching the build image's (bookworm), so
# the binary finds the glibc it was linked against.
#
#   . tools/images.sh
#   podman build -f packaging/Containerfile \
#     --build-arg RUST_IMAGE="$RUST_IMAGE" --build-arg NODE_IMAGE="$NODE_IMAGE" -t pop .
#
# The images are pinned by digest: tools/images.sh for the build, and the
# runtime below (debian:bookworm-20261027-slim, multi-arch).

ARG RUST_IMAGE
ARG NODE_IMAGE

FROM ${NODE_IMAGE} AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY . .
# The web app is compiled into the binary, so it is in place first.
COPY --from=web /src/web/dist web/dist
# And the updater (#148), which the release ships beside POP.
RUN cargo build --locked --release -p pop-server -p pop-updater \
 && cp target/release/pop /pop && cp target/release/pop-updater /pop-updater

FROM docker.io/library/debian@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system pop \
 && useradd --system --gid pop --home-dir /var/lib/pop --shell /usr/sbin/nologin pop \
 && install -d -o pop -g pop -m 0700 /var/lib/pop
COPY --from=build /pop /usr/local/bin/pop
COPY --from=build /pop-updater /usr/local/bin/pop-updater
USER pop
# Everything POP keeps, only POP can read (threat model, gap 9).
ENV POP_STORAGE_DATA_DIR=/var/lib/pop \
    POP_SERVER_LISTEN=0.0.0.0:8080
VOLUME ["/var/lib/pop"]
EXPOSE 8080
# No HEALTHCHECK: the image holds no HTTP client. Probe GET /healthz from
# outside (200 when every part POP depends on works, 503 naming what does not).
ENTRYPOINT ["/usr/local/bin/pop"]
