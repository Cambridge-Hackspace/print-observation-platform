# A backup of POP's data (#183), run nightly by pop-backup.timer: one archive
# in /var/lib/pop-backups, and those older than two weeks deleted. Safe while POP
# runs. Copy them off the box; restoring needs the same POP_SECRETS_KEY.
#
# Now, by hand: sudo systemctl start pop-backup.service

[Unit]
Description=A backup of POP's data
Documentation=https://github.com/Cambridge-Hackspace/print-observation-platform/blob/main/docs/deployment.md
After=pop.service

[Service]
Type=oneshot
User=pop
Group=pop
# As pop.service has them: systemd reads the secrets, as root.
EnvironmentFile=-/etc/pop/pop.env
Environment=POP_STORAGE_DATA_DIR=/var/lib/pop
UMask=0077
# systemd makes it, the pop user's alone, before it sets up the sandbox
# below: a folder made by a step of this unit would be too late, since the
# sandbox is set up for every step (#188).
StateDirectory=pop-backups
StateDirectoryMode=0700
# The time too, so a second run in a day is not refused for the name.
ExecStart=/bin/sh -c 'exec /usr/local/bin/pop --config /etc/pop/pop.toml backup "/var/lib/pop-backups/pop-$(date +%%Y-%%m-%%dT%%H%%M%%S).tar.gz"'
ExecStart=/usr/bin/find /var/lib/pop-backups -name pop-*.tar.gz -mtime +14 -delete

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
